<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>SeedGen</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
  </ItemGroup>
  <!-- Terrain generation shared with the browser build; its tests run against the game. -->
  <ItemGroup>
    <ProjectReference Include="Vh.WorldGen/Vh.WorldGen.csproj" />
    <Compile Remove="Vh.WorldGen*/**" />
    <Content Remove="Vh.WorldGen*/**" />
    <None Remove="Vh.WorldGen*/**" />
  </ItemGroup>
  <!-- oracle/ is a separate net472 BepInEx plugin, built against the game's own
       assemblies (see oracle/README.md). Neither its sources nor its generated
       obj/ may be compiled into seedgen. -->
  <ItemGroup>
    <Compile Remove="oracle/**" />
    <Content Remove="oracle/**" />
    <None Remove="oracle/**" />
    <EmbeddedResource Remove="oracle/**" />
  </ItemGroup>
</Project>
