<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads Valheim save files: character profiles (.fch) and world metadata
       (.fwl / _main.N.fwl2). Ported from the game's own Load methods, every
       version gate included, so old saves parse too. No dependencies, so the
       same code runs in the API and in the native file watcher.
       Checked against real saves by Vh.Character.Tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
