<Project Sdk="Microsoft.NET.Sdk">
  <!-- Parses every save in the local Valheim folders (characters_local,
       characters, worlds_local, worlds) and checks the parser against the
       game's own invariants. Tests are no-ops on machines without saves.
       Run: dotnet test character/Vh.Character.Tests -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Vh.Character/Vh.Character.csproj" />
  </ItemGroup>
</Project>
