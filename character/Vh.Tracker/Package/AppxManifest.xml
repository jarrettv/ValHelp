<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package for the Microsoft Store. scripts/pack_tracker_msix.ps1 fills in the
  $...$ placeholders (identity values come from Partner Center, Product identity).
  The Store signs the package, so it is uploaded unsigned.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>ValHelp Tracker</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Tracker" Executable="ValHelpTracker.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="ValHelp Tracker"
        Description="Uploads the Valheim characters you choose to valheim.help so you can follow your runs."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Starts with Windows after the first launch; users turn it off in Settings, Apps, Startup. -->
        <desktop:Extension Category="windows.startupTask" Executable="ValHelpTracker.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ValHelpTracker" Enabled="true" DisplayName="ValHelp Tracker" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
